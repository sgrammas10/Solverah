{
    "name": "vite-react-typescript-starter",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "type-check": "tsc -b",
        "generate:api": "openapi-typescript docs/openapi.json -o src/shared/api/schema.ts",
        "generate:api:check": "npm run generate:api && git ls-files --error-unmatch src/shared/api/schema.ts && git diff --exit-code -- src/shared/api/schema.ts",
        "preview": "vite preview",
        "test": "vitest",
        "test:e2e": "playwright test",
        "size": "size-limit"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tanstack/react-query": "^5.62.0",
        "@types/node": "^24.3.0",
        "json2csv": "^6.0.0-alpha.2",
        "lucide-react": "^0.344.0",
        "node-fetch": "^3.3.2",
        "openapi-fetch": "^0.17.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^9.0.1",
        "react-router-dom": "^7.18.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.1",
        "@playwright/test": "^1.62.1",
        "@size-limit/file": "12.1.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.5.2",
        "@types/jest": "^30.0.0",
        "@types/react": "^18.3.24",
        "@types/react-dom": "^18.3.0",
        "@types/testing-library__react": "^10.0.1",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.18",
        "eslint": "^9.9.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.11",
        "globals": "^15.9.0",
        "jest": "^30.3.0",
        "jsdom": "^25.0.1",
        "msw": "^2.15.0",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.4.35",
        "size-limit": "12.1.0",
        "tailwindcss": "^3.4.1",
        "ts-jest": "^29.4.9",
        "typescript": "^5.5.3",
        "typescript-eslint": "^8.3.0",
        "vite": "^7.1.7",
        "vitest": "^4.1.4"
    }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // "tests/msw" is in the program so the MSW handlers are type-checked against
  // the generated OpenAPI types by `npm run type-check`. Without it the
  // contract binding in tests/msw/contract.ts would be advisory: a handler
  // returning a shape the API does not return would compile nowhere and fail
  // nothing, which is the failure the handlers exist to prevent.
  "include": ["src", "tests/msw"]
}


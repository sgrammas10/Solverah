# ── Database ──────────────────────────────────────────────────────────────────
# Port 5433: that is where the compose stack publishes Postgres, because a
# native Windows service shadows 5432 (infra/docker/compose.yml explains it).
# The test suite and Scripts/capture_contract.py use databases of their own,
# solverah_test and solverah_contract, and do not read this file.
DATABASE_URL=postgresql://user:password@localhost:5433/solverah

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# ── Storage (S3 / Cloudflare R2) ──────────────────────────────────────────────
S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── Backup storage (flask backups run) ───────────────────────────────────────
# SEPARATE CREDENTIALS FROM THE S3_* ABOVE, deliberately: a compromised
# application key must not be able to read or delete the backups. A different
# bucket AND a different token — config.py refuses to boot if either matches
# the app's, and nothing ever falls back to S3_* when these are unset.
#
# Optional as a GROUP: leave all four empty and `flask backups run` refuses
# (nowhere to upload). Set three of four and the app will not boot — a
# half-configured backup destination looks configured until the restore.
#
# Locally, prefer `flask backups run --local-dir <dir>` over filling these in:
# the Flask CLI loads this file before the app's guard, so real values here mean
# a local run uploads to and prunes the real bucket. See
# docs/RUNBOOK_SCENARIO_A_CRON.md.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_BUCKET_NAME=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Optional; defaults to "auto" (R2 has exactly one region).
BACKUP_S3_REGION=

# ── AI / LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ── O*NET Web Services ────────────────────────────────────────────────────────
# Register at https://services.onetcenter.org/developer/ to get a key.
# Used for occupation search, skills profiles, and job zone lookups.
# See backend/services/onet_client.py
ONET_API_KEY=

# ── Connection pool & timeouts (solverah/config.py) ──────────────────────────
# Defaults are sane for a single small instance. Raise DB_POOL_SIZE only
# alongside Postgres max_connections: gunicorn workers x pool_size is the real
# connection demand, and exhausting max_connections takes the whole app down.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=10
# Server-side ceiling on a single statement. A runaway query is cancelled by
# Postgres rather than holding a worker until gunicorn kills it.
DB_STATEMENT_TIMEOUT_MS=15000

# ── Shared state ─────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION, and it now configures three things rather than one.
#
#   * Rate limiting. Without it Flask-Limiter counts per-worker: configured
#     limits are N-workers times looser and reset on every deploy.
#   * The Celery broker and result backend (Phase 3). Without it every queued
#     task runs INLINE IN THE WEB WORKER -- which is the request-path blocking
#     Phase 3 exists to remove, so the app logs a warning if that happens in
#     production.
#   * The read cache for company detail and the dashboard. Without it those
#     reads simply hit the database, which is correct but slower.
#
# All three degrade rather than fail, which is what lets CI run with no Redis at
# all. Each can be split onto its own instance with the two overrides below.
REDIS_URL=
RATELIMIT_STORAGE_URI=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Run queued work inline in the calling process instead of handing it to a
# worker. Defaults to true when APP_ENV=testing or no broker is configured, and
# should never be set in production -- see the warning above.
CELERY_TASK_ALWAYS_EAGER=

# Backstop for a cache invalidation somebody forgot to write, not the mechanism.
# Every cached read is dropped by key on the write that changes it; if
# correctness ever depends on this number, the missing invalidation is the bug.
CACHE_DEFAULT_TTL_SECONDS=300

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG          # CRITICAL|ERROR|WARNING|INFO|DEBUG
LOG_FORMAT=console       # console for local, json in production
RELEASE=dev              # stamped on every log line; set to the git SHA in CI

# ── Edge ─────────────────────────────────────────────────────────────────────
# Number of proxies in front of the app. Setting this HIGHER than reality lets a
# client spoof its own IP via X-Forwarded-For, which is worse than not trusting
# the header at all. Render terminates at exactly one proxy; 0 for local runs.
TRUSTED_PROXY_COUNT=0

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_MINUTES=60

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_ENV=development
CONFIRM_TOKEN_EXP_HOURS=48
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

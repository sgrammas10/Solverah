# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env

users.db
*.sqlite
*.db

.env*
# The example file is documentation, not configuration — without this negation
# the `.env*` glob swallowed it and every edit to it reached nobody (found
# 2026-08-27, fixed 2026-09-02). It is scanned for secret-shaped values before
# each re-track; keep placeholders only.
!.env.example
# datasets/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Debug output
scoring_debug.txt
llm_debug.txt
# Scratch / staging dirs that should never have been tracked
_to_delete/
_mutation_tmp/
instance/
.venv/
venv/

# Coverage
htmlcov/
.coverage
.coverage.*

# Database snapshots taken by `make db-snapshot` (docs/RUNBOOK_DATABASE_ROLLBACK.md).
# These are full copies of whatever DATABASE_URL pointed at, production included.
backups/

# TypeScript incremental build info (`tsc -b` drops these at the repo root)
*.tsbuildinfo

# Celery beat's local schedule state (`--beat` in infra/docker/compose.yml). The
# worker bind-mounts the repo at /app and beat writes its last-run times to its
# working directory, so this appears at the repo root the first time the stack is
# started. It is a shelve database, per-machine and per-run.
celerybeat-schedule*
celerybeat.pid

# Playwright (tests/e2e). Reports and traces are per-run artifacts; the browser
# binaries live in the user-level ms-playwright cache, not in the repo.
test-results/
playwright-report/
blob-report/
.playwright/

# _scrub_env staging areas are scratch: packets_raw/ holds a copy of a packet that
# already lives in ground_truth/packets/, and packets_out/ is transient until the run is
# promoted to anonymization/ or archived to _scrub_env_runs/. The run archives ARE tracked
# deliberately -- they are the evidence a scrub was verified.
Solverah_IP/ground_truth/_scrub_env/packets_raw/*
Solverah_IP/ground_truth/_scrub_env/packets_out/*
!Solverah_IP/ground_truth/_scrub_env/packets_raw/.gitkeep
!Solverah_IP/ground_truth/_scrub_env/packets_out/.gitkeep

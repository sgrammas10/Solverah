# Build-context exclusions. Everything here either bloats the image, breaks
# reproducibility, or must never be baked into a layer.

# Secrets — an image layer is not a secret store, and layers are extractable
# from any registry the image reaches.
.env
.env.*
!.env.example
*.pem
*.key

.git
.github
node_modules
dist
dist-ssr
.vscode
.idea

__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.venv
venv

# Local databases and scratch state
instance
*.db
*.sqlite
_to_delete
_mutation_tmp

# Not needed at runtime
tests
src
docs
*.docx
# Research and IP corpus (packets with verbatim third-party text, rater data,
# drafts): never needed at runtime -- the CompanyLens scorer ships its own frozen
# anchors copy (solverah/services/company_research/anchors_v3_1.json). Excluded
# 2026-10-14 (Sebastian). If a runtime path ever reads Solverah_IP, it fails in
# the image, not silently.
Solverah_IP
*.xlsx
*.png
llm_debug.txt
scoring_debug.txt
